# Environment Configuration for OrthoAndSpineTools Backend

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/orthoandspinetools"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email — Amazon SES (see docs/SES_AWS_SETUP.md for AWS Console checklist)
# Required to send: region + IAM keys + verified EMAIL_FROM domain
AWS_SES_REGION="us-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
EMAIL_FROM="noreply@orthoandspinetools.com"
EMAIL_FROM_NAME="OrthoAndSpineTools"
# Optional Reply-To (recommended for support mail)
EMAIL_REPLY_TO="support@orthoandspinetools.com"
# SES configuration set (orthoandspinetools-prod) — ties sends to SNS bounce/complaint events
AWS_SES_CONFIGURATION_SET="orthoandspinetools-prod"
# Required in production when SES is enabled — SNS topic ARN for /api/ses/events (signature-verified)
AWS_SES_SNS_TOPIC_ARN=""
# Set to "false" only for local SNS debugging (never in production)
AWS_SNS_VERIFY_SIGNATURES="true"
# Rate limit: forgot-password + resend-verification (per IP + email)
AUTH_EMAIL_RATE_LIMIT_MAX=5
AUTH_EMAIL_RATE_LIMIT_WINDOW_MS=900000
# Digest emails (notifications + followed communities)
EMAIL_DIGEST_ENABLED="true"
EMAIL_DIGEST_MIN_HOURS=96
EMAIL_DIGEST_LOOKBACK_HOURS=168
EMAIL_DIGEST_MAX_USERS_PER_RUN=200
EMAIL_DIGEST_MAX_POSTS_PER_EMAIL=5
# Required for non-auth cron endpoint: POST /api/notifications/digest/cron (header x-digest-secret)
EMAIL_DIGEST_CRON_SECRET=""

# Uptime monitor (host cron → scripts/uptime-monitor.sh → dist/cli/sendUptimeAlert.js)
# UPTIME_ALERT_TO="admin@orthoandspinetools.com"

# Legacy SMTP (unused by app code today; kept for reference)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@orthoandspinetools.com"

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# HIPAA Compliance
ENCRYPTION_KEY="your-encryption-key-change-this-in-production"
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=2555

# Logging
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET="your-session-secret-change-this-in-production"

# API Configuration
API_VERSION="v1"
API_PREFIX="/api"

