// Prisma Database Schema for OrthoAndSpineTools Medical Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for medical professionals
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  firstName         String
  lastName          String
  passwordHash     String
  isEmailVerified   Boolean   @default(false)
  emailDigestEnabled Boolean  @default(true) @map("email_digest_enabled")
  isActive          Boolean   @default(true)
  isAdmin           Boolean   @default(false) @map("is_admin")  // Admin privileges
  isVerifiedPhysician Boolean @default(false) @map("is_verified_physician")  // Verified physician badge
  isVerifiedFounder   Boolean @default(false) @map("is_verified_founder")    // Verified founder badge
  
  // Medical credentials
  medicalLicense    String?
  npiNumber         String?   @unique @map("npi_number")
  practiceCountry   String?   @map("practice_country")
  physicianVerificationPending Boolean @default(false) @map("physician_verification_pending")
  physicianVerificationMethod String? @map("physician_verification_method")
  specialty         String?
  subSpecialty      String?
  institution       String?
  yearsExperience   Int?
  
  // Profile information
  bio               String?
  profileImage      String?
  location          String?
  website           String?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  
  // Relations
  posts             Post[]
  comments          Comment[]
  communities       Community[] @relation("CommunityMembers")
  ownedCommunities  Community[] @relation("CommunityOwner")
  moderatedCommunities CommunityModerator[]
  toolReviews       ToolReview[]
  connections       Connection[] @relation("UserConnections")
  connectedUsers    Connection[] @relation("ConnectedUsers")
  connectionRequests ConnectionRequest[] @relation("ConnectionRequests")
  connectionRequestsReceived ConnectionRequest[] @relation("ConnectionRequestsReceived")
  postVotes         PostVote[]
  commentVotes      CommentVote[]
  auditLogs         AuditLog[]
  visitorLogs       CommunityVisitorLog[]
  contributions     CommunityContribution[]
  karma             UserKarma?
  notifications     Notification[]
  postPollVotes     PostPollVote[]
  maudeBrandRequests MaudeBrandRequest[]
  analyticsPageViews AnalyticsPageView[]
  implantReviews     ImplantReview[]
  implantComments    ImplantComment[]
  implantCommentVotes ImplantCommentVote[]
  
  @@map("users")
}

model PostPollVote {
  id          String   @id @default(cuid())
  postId      String   @map("post_id")
  userId      String   @map("user_id")
  optionIndex Int      @map("option_index")
  createdAt   DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_poll_votes")
}

// In-app notifications (replies, comments on your posts, etc.)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // COMMENT_ON_POST | REPLY_TO_COMMENT | ...
  title     String
  message   String
  link      String?
  actorId   String?
  postId    String?
  commentId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

model EmailSuppression {
  id          String   @id @default(cuid())
  email       String   @unique
  reason      String
  source      String   @default("ses_sns")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastEventAt DateTime?

  @@index([reason])
  @@map("email_suppressions")
}

// Community model for medical specialties
model Community {
  id                String    @id @default(cuid())
  name              String    @unique
  slug              String    @unique
  description       String
  rules             String?
  profileImage      String?   @map("profile_image") // Community profile picture URL
  bannerImage       String?   @map("banner_image")  // Community banner image URL
  isPrivate         Boolean   @default(false)
  isActive          Boolean   @default(true)
  
  // Community settings
  allowPosts        Boolean   @default(true)
  allowComments     Boolean   @default(true)
  requireApproval   Boolean   @default(false)
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  ownerId           String
  owner             User      @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members           User[]    @relation("CommunityMembers")
  posts             Post[]
  moderators        CommunityModerator[]
  visitorLogs       CommunityVisitorLog[]
  contributions     CommunityContribution[]
  tags              CommunityTag[]
  
  @@map("communities")
}

// Community moderator model
model CommunityModerator {
  id                String    @id @default(cuid())
  communityId       String
  userId            String
  role              String    @default("moderator") // moderator, admin
  
  // Timestamps
  createdAt         DateTime  @default(now())
  
  // Relations
  community         Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([communityId, userId])
  @@map("community_moderators")
}

// Post model for discussions and case studies
model Post {
  id                String    @id @default(cuid())
  title             String
  content           String
  type              String    @default("discussion") // discussion, case_study, tool_review, question, link, poll
  linkUrl           String?   @map("link_url")
  pollOptions       Json?     @map("poll_options")
  pollEndsAt        DateTime? @map("poll_ends_at")
  isPinned          Boolean   @default(false)
  isLocked          Boolean   @default(false)
  isDeleted         Boolean   @default(false)
  
  // Medical context
  specialty         String?
  caseType          String?
  patientAge        Int?
  procedureType     String?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  authorId          String
  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  communityId       String
  community         Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  comments          Comment[]
  attachments       PostAttachment[]
  votes             PostVote[]
  tags              PostTag[]
  pollVotes         PostPollVote[]
  
  @@index([isDeleted, createdAt(sort: Desc)])
  @@index([communityId, isDeleted, createdAt(sort: Desc)])
  @@index([authorId, isDeleted, createdAt(sort: Desc)])
  @@index([isDeleted, type, createdAt(sort: Desc)])
  @@index([isDeleted, updatedAt(sort: Desc)])
  @@map("posts")
}

// Post attachment model
model PostAttachment {
  id                String    @id @default(cuid())
  postId            String
  filename          String
  originalName      String
  mimeType          String
  size              Int
  path              String
  
  // Cloudinary fields
  cloudinaryPublicId String?
  cloudinaryUrl     String?
  optimizedUrl      String?
  thumbnailUrl      String?
  width             Int?
  height            Int?
  duration          Int?      // for videos
  
  // Timestamps
  createdAt         DateTime  @default(now())
  
  // Relations
  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@map("post_attachments")
}

// Comment model for replies
model Comment {
  id                String    @id @default(cuid())
  content           String
  isDeleted         Boolean   @default(false)
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  authorId          String
  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId            String
  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId          String?
  parent            Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies           Comment[] @relation("CommentReplies")
  votes             CommentVote[]
  
  @@index([postId, isDeleted, createdAt(sort: Asc)])
  @@index([authorId, isDeleted, createdAt(sort: Desc)])
  @@map("comments")
}

// Medical tool model
model MedicalTool {
  id                String    @id @default(cuid())
  name              String
  description       String
  category          String
  subCategory       String?
  manufacturer      String
  model             String?
  specifications    Json?
  
  // Tool details
  indications       String?
  contraindications String?
  complications     String?
  costRange         String?
  availability      String?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  reviews           ToolReview[]
  
  @@map("medical_tools")
}

// Tool review model
model ToolReview {
  id                String    @id @default(cuid())
  rating            Int       // 1-5 stars
  title             String
  content           String
  pros              String?
  cons              String?
  wouldRecommend    Boolean
  
  // Medical context
  procedureType     String?
  patientOutcome    String?
  easeOfUse         Int?      // 1-5 rating
  durability        Int?      // 1-5 rating
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  authorId          String
  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  toolId            String
  tool              MedicalTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  
  @@map("tool_reviews")
}

// Post vote model
model PostVote {
  id                String    @id @default(cuid())
  postId            String
  userId            String
  type              String    // upvote, downvote
  
  // Timestamps
  createdAt         DateTime  @default(now())
  
  // Relations
  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([postId])
  @@unique([postId, userId])
  @@map("post_votes")
}

// Comment vote model
model CommentVote {
  id                String    @id @default(cuid())
  commentId         String
  userId            String
  type              String    // upvote, downvote
  
  // Timestamps
  createdAt         DateTime  @default(now())
  
  // Relations
  comment           Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([commentId, userId])
  @@map("comment_votes")
}

// User connections for professional networking
model Connection {
  id                String    @id @default(cuid())
  userId            String
  connectedUserId    String
  status            String    @default("pending") // pending, accepted, blocked
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  user              User      @relation("UserConnections", fields: [userId], references: [id], onDelete: Cascade)
  connectedUser     User      @relation("ConnectedUsers", fields: [connectedUserId], references: [id], onDelete: Cascade)
  
  @@unique([userId, connectedUserId])
  @@map("connections")
}

// Connection request model
model ConnectionRequest {
  id                String    @id @default(cuid())
  fromUserId        String
  toUserId          String
  message           String?
  status            String    @default("pending") // pending, accepted, declined
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  fromUser          User      @relation("ConnectionRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser            User      @relation("ConnectionRequestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  
  @@unique([fromUserId, toUserId])
  @@map("connection_requests")
}

// Audit log model for HIPAA compliance
model AuditLog {
  id                String    @id @default(cuid())
  userId            String?
  action            String
  resource          String
  resourceId        String?
  details           Json?
  ipAddress         String?
  userAgent         String?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  
  // Relations
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@map("audit_logs")
}

// Session model for user sessions
model Session {
  id                String    @id @default(cuid())
  userId            String
  token             String    @unique
  expiresAt         DateTime
  isActive          Boolean   @default(true)
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@map("sessions")
}

// Community visitor log model for tracking weekly visitors
model CommunityVisitorLog {
  id                String    @id @default(cuid())
  communityId       String
  userId            String?
  ipAddress         String?
  userAgent         String?
  visitDate         DateTime  @default(now())
  
  // Relations
  community         Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@map("community_visitor_logs")
}

// Community contribution tracking model for weekly contributions
model CommunityContribution {
  id                String    @id @default(cuid())
  communityId       String
  userId            String
  contributionType  String    // 'post', 'comment', 'vote'
  contributionId    String?   // ID of the post/comment/vote
  points            Int       @default(1) // Points for this contribution
  createdAt         DateTime  @default(now())
  
  // Relations
  community         Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("community_contributions")
}

// User karma tracking model for Reddit-style karma system
model UserKarma {
  id                String    @id @default(cuid())
  userId            String    @unique @map("user_id")
  postKarma         Int       @default(0) @map("post_karma") // Karma from posts
  commentKarma      Int       @default(0) @map("comment_karma") // Karma from comments
  awardKarma         Int       @default(0) @map("award_karma") // Karma from awards/endorsements
  totalKarma         Int       @default(0) @map("total_karma") // Total karma (post + comment + award)
  
  // Timestamps
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_karma")
}

// Community tag model for community-specific tags
model CommunityTag {
  id                String    @id @default(cuid())
  communityId       String
  name              String
  color             String?   // Optional color for tag display (hex code)
  description       String?   // Optional description for tag
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  community         Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  posts             PostTag[]
  
  @@unique([communityId, name]) // Ensure unique tag names per community
  @@map("community_tags")
}

// Post tag model (many-to-many relationship between posts and tags)
model PostTag {
  id                String    @id @default(cuid())
  postId            String
  tagId             String
  
  // Timestamps
  createdAt         DateTime  @default(now())
  
  // Relations
  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag               CommunityTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@index([tagId])
  @@unique([postId, tagId]) // Ensure a post can't have the same tag twice
  @@map("post_tags")
}

// User requests to add / prioritize a MAUDE brand or company not found in search.
model MaudeBrandRequest {
  id           String   @id @default(cuid())
  brand        String
  company      String?
  specialty    String?
  note         String?
  contactEmail String?  @map("contact_email")
  userId       String?  @map("user_id")
  status       String   @default("pending") // pending | reviewed | added | declined
  ipHash       String?  @map("ip_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([brand])
  @@map("maude_brand_requests")
}

model AnalyticsPageView {
  id          String   @id @default(cuid())
  path        String
  referrer    String?
  visitorHash String   @map("visitor_hash")
  /// ISO 3166-1 alpha-2 from GeoIP / CF-IPCountry when available
  country     String?
  userId      String?  @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorHash, createdAt])
  @@index([country, createdAt])
  @@map("analytics_page_views")
}

model AnalyticsBot {
  family    String   @id
  category  String
  views     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("analytics_bots")
}

model AnalyticsBotPath {
  path      String   @id
  views     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("analytics_bot_paths")
}

model AnalyticsBotDaily {
  day     DateTime @id @db.Date
  views   Int      @default(0)
  aiAgent Int      @default(0) @map("ai_agent")
  aiCrawl Int      @default(0) @map("ai_crawl")

  @@map("analytics_bot_daily")
}

model AnalyticsBotDailyFamily {
  day    DateTime @db.Date
  family String
  views  Int      @default(0)

  @@id([day, family])
  @@map("analytics_bot_daily_family")
}

model AnalyticsBotRecent {
  id        String   @id @default(cuid())
  family    String
  category  String
  path      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("analytics_bot_recent")
}

model AnalyticsBotState {
  key           String    @id
  inode         String?
  offset        BigInt    @default(0)
  backfilledAt  DateTime? @map("backfilled_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("analytics_bot_state")
}

/// Proprietary implant directory (public catalog; reviews are members-only).
model Implant {
  id              String   @id @default(cuid())
  slug            String   @unique
  brandName       String   @map("brand_name")
  systemName      String?  @map("system_name")
  company         String?
  specialty       String   @default("spine")
  anatomy         String?
  deviceClass     String   @map("device_class")
  description     String?
  /// Longer clinical / AI-citable body for detail + .md twins
  longDescription String?  @map("long_description") @db.Text
  indications     String?  @db.Text
  contraindications String? @db.Text
  seoTitle        String?  @map("seo_title")
  seoDescription  String?  @map("seo_description")
  status          String   @default("published") // draft | published | verified
  maudeBrandKey   String?  @map("maude_brand_key")
  /// Direct URL to surgeon instructional / surgical technique sheet (prefer PDF)
  techniqueGuideUrl   String?  @map("technique_guide_url") @db.Text
  /// Short label for the guide link (e.g. "Surgical technique guide")
  techniqueGuideTitle String?  @map("technique_guide_title")
  /// FDA 510(k) or PMA number (e.g. "K123456" or "P110009")
  fdaNumber       String?  @map("fda_number")
  /// FDA decision date (approval/clearance)
  fdaDecisionDate DateTime? @map("fda_decision_date") @db.Date
  /// FDA applicant name at time of approval (from openFDA/AccessGUDID)
  fdaApplicant    String?  @map("fda_applicant")
  /// Device materials (from FDA labeling/AccessGUDID)
  fdaMaterials    String?  @map("fda_materials")
  /// Source URL for FDA data (openFDA or AccessGUDID link)
  fdaSourceUrl    String?  @map("fda_source_url") @db.Text
  /// Proprietary OST Directory Score 0–10 (catalog + community evidence — not clinical advice)
  aiRating        Float?   @map("ai_rating")
  aiSummary       String?  @map("ai_summary") @db.Text
  aiRatedAt       DateTime? @map("ai_rated_at")
  /// Structural catalog component 0–10 (completeness / verification / media)
  catalogScore    Float?   @map("catalog_score")
  /// Community evidence component 0–10 from vote-weighted implant comments
  communityScore  Float?   @map("community_score")
  /// Effective sample size used in community blend (confidence)
  ratingSampleN   Float?   @map("rating_sample_n")
  /// Algorithm id, e.g. ost-dir-v2
  ratingVersion   String?  @map("rating_version")
  /// Optional admin lock — when set, auto-recompute will not overwrite aiRating
  aiRatingLocked  Boolean  @default(false) @map("ai_rating_locked")
  /// ost-dir-v2: listing+discussion utility before MAUDE hazard
  utilityScore    Float?   @map("utility_score")
  /// ost-dir-v2: MAUDE quietness 0–10 (10 = quiet vs peers)
  maudeScore      Float?   @map("maude_score")
  /// ost-dir-v2: MAUDE hazard 0–1 (1 = alarming)
  maudeHazard     Float?   @map("maude_hazard")
  /// ost-dir-v2: quiet | watch | elevated | unlinked | insufficient
  maudeSignal     String?  @map("maude_signal")
  /// Full facet breakdown JSON for detail UI
  scoreBreakdown  Json?    @map("score_breakdown")
  /// Legacy: mean of star reviews (1–5); prefer communityScore going forward
  memberRatingAvg Float?   @map("member_rating_avg")
  /// Denormalized search blob (brand, aliases, company, class, anatomy…)
  searchText      String   @default("") @map("search_text") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  publishedAt     DateTime? @map("published_at")

  aliases  ImplantAlias[]
  images   ImplantImage[]
  reviews  ImplantReview[]
  comments ImplantComment[]
  editLogs ImplantEditLog[]

  @@index([specialty, status])
  @@index([deviceClass])
  @@index([company])
  @@index([status, publishedAt])
  @@index([aiRating])
  @@index([status, specialty, aiRating(sort: Desc)])
  @@index([status, company])
  @@map("implants")
}

model ImplantEditLog {
  id        String   @id @default(cuid())
  implantId String   @map("implant_id")
  actor     String   // ingest:grokbot | admin:{id} | user:{id}
  action    String   // upsert | publish | verify | image_add | status_change
  detail    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  implant   Implant  @relation(fields: [implantId], references: [id], onDelete: Cascade)

  @@index([implantId, createdAt])
  @@map("implant_edit_logs")
}

model ImplantAlias {
  id        String  @id @default(cuid())
  implantId String  @map("implant_id")
  alias     String
  implant   Implant @relation(fields: [implantId], references: [id], onDelete: Cascade)

  @@unique([implantId, alias])
  @@index([alias])
  @@map("implant_aliases")
}

model ImplantImage {
  id           String   @id @default(cuid())
  implantId    String   @map("implant_id")
  kind         String   // product | xray | diagram
  url          String
  alt          String?
  attribution  String?
  licenseNote  String?  @map("license_note")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  implant      Implant  @relation(fields: [implantId], references: [id], onDelete: Cascade)

  @@index([implantId, kind])
  @@map("implant_images")
}

model ImplantReview {
  id        String   @id @default(cuid())
  implantId String   @map("implant_id")
  userId    String   @map("user_id")
  rating    Int      // 1-5
  title     String?
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  implant Implant @relation(fields: [implantId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([implantId, userId])
  @@index([implantId, createdAt])
  @@map("implant_reviews")
}

/// Threaded discussion on an implant listing (upvote / downvote like posts).
model ImplantComment {
  id        String   @id @default(cuid())
  implantId String   @map("implant_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  body      String   @db.Text
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  implant Implant              @relation(fields: [implantId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  ImplantComment?      @relation("ImplantCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ImplantComment[]     @relation("ImplantCommentReplies")
  votes   ImplantCommentVote[]

  @@index([implantId, createdAt])
  @@index([parentId])
  @@index([userId, createdAt])
  @@map("implant_comments")
}

model ImplantCommentVote {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  value     Int      // 1 | -1
  createdAt DateTime @default(now()) @map("created_at")

  comment ImplantComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("implant_comment_votes")
}

/// Staging table for FDA-sourced implant data before human review and promotion to live.
/// Every populated field carries a citation via field_citations JSONB and the related citations table.
model ImplantCatalogStaging {
  id                String    @id @default(cuid())
  /// Source identifier: openfda-510k | openfda-pma | accessgudid
  source            String
  /// The K-number, P-number, or GUDID DI
  sourceRecordId    String    @map("source_record_id")
  /// FDA product code (e.g. MAX, NKB, ODP)
  productCode       String?   @map("product_code")
  /// FDA 510(k) or PMA number (e.g. K123456, P110009)
  fdaNumber         String?   @map("fda_number")
  /// FDA decision/clearance date
  fdaDecisionDate   DateTime? @map("fda_decision_date") @db.Date
  /// FDA applicant/manufacturer name at time of submission
  fdaApplicant      String?   @map("fda_applicant")
  /// Device name from FDA
  deviceName        String?   @map("device_name")
  /// FDA device class (1, 2, 3)
  deviceClass       String?   @map("device_class")
  /// Device materials (from GUDID or summary PDF — null if unknown)
  material          String?
  /// Device components (from GUDID — null if unknown)
  components        String?
  /// FDA advisory committee code (e.g. OR for Orthopedic)
  advisoryCommittee String?   @map("advisory_committee")
  /// Full raw JSON response from the API for debugging/audit
  rawJson           Json      @map("raw_json")
  /// JSONB map of field_name → { sourceUrl, sourceType, retrievedAt }
  fieldCitations    Json      @default("{}") @map("field_citations")
  /// When this record was retrieved from the source API
  retrievedAt       DateTime  @default(now()) @map("retrieved_at")
  /// Review status: pending | reviewed | approved | rejected
  reviewStatus      String    @default("pending") @map("review_status")
  /// Optional notes from human reviewer
  reviewNotes       String?   @map("review_notes")
  /// When the record was reviewed
  reviewedAt        DateTime? @map("reviewed_at")
  /// Who reviewed (user id or admin identifier)
  reviewedBy        String?   @map("reviewed_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  citations ImplantCatalogStagingCitation[]

  @@unique([source, sourceRecordId])
  @@index([reviewStatus])
  @@index([productCode])
  @@index([fdaNumber])
  @@index([fdaApplicant])
  @@index([deviceName])
  @@index([createdAt])
  @@map("implant_catalog_staging")
}

/// Per-field source/citation tracking for staging records.
model ImplantCatalogStagingCitation {
  id          String   @id @default(cuid())
  stagingId   String   @map("staging_id")
  /// Field name this citation applies to (e.g. fdaApplicant, deviceName)
  fieldName   String   @map("field_name")
  /// Source URL where this value was obtained
  sourceUrl   String   @map("source_url")
  /// Source type: openfda-510k | openfda-pma | accessgudid | summary-pdf
  sourceType  String   @map("source_type")
  /// When this value was retrieved
  retrievedAt DateTime @map("retrieved_at")
  /// The raw value as retrieved (before normalization)
  rawValue    String?  @map("raw_value")
  createdAt   DateTime @default(now()) @map("created_at")

  staging ImplantCatalogStaging @relation(fields: [stagingId], references: [id], onDelete: Cascade)

  @@unique([stagingId, fieldName])
  @@index([stagingId])
  @@map("implant_catalog_staging_citation")
}

