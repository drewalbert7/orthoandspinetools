[Unit]
Description=OST Postgres encrypted backup to R2 (copy-only, immutable)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/ost-backup/ost-db-backup.env
ExecStart=/usr/local/sbin/ost-db-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/mnt/HC_Volume_106016238 /var/log /run
NoNewPrivileges=true
TimeoutStartSec=45min
