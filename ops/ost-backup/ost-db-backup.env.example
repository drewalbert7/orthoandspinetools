# /etc/ost-backup/ost-db-backup.env  (root:root 600). No secrets in here; R2 keys live in rclone.conf.
OST_PG_CONTAINER=orthoandspinetools-postgres
OST_DB_NAME=orthoandspinetools
OST_BACKUP_DB_USER=ost_backup
OST_BACKUP_LOCAL_DIR=/mnt/HC_Volume_106016238/ost-db-backups
OST_BACKUP_LOCAL_KEEP_DAYS=7
RCLONE_CONFIG=/etc/ost-backup/rclone.conf
OST_BACKUP_REMOTE=ost-r2
OST_BACKUP_BUCKET=drewalbertmd-backups
OST_BACKUP_PREFIX=ost-db
OST_BACKUP_WEEKLY_PREFIX=ost-db-weekly
OST_BACKUP_MONTHLY_PREFIX=ost-db-monthly
OST_BACKUP_GNUPGHOME=/etc/ost-backup/gnupg
